# >>> provider: supabase
# Supabase project URL. Find it in Supabase Dashboard > Project Settings > API.
PUBLIC_SUPABASE_URL=

# Public anonymous key. Find it in Supabase Dashboard > Project Settings > API.
PUBLIC_SUPABASE_ANON_KEY=

# Project reference used by `bun run db:link`. Bun does not read it from this file:
# pass it in your shell instead, e.g. SUPABASE_PROJECT_REF=<ref> bun run db:link
# SUPABASE_PROJECT_REF=
# <<< provider: supabase

# >>> provider: turso
# Turso database URL, for example libsql://your-database.turso.io.
TURSO_DATABASE_URL=

# Turso auth token. This can be left empty when using a local/file database.
TURSO_AUTH_TOKEN=
# <<< provider: turso

# >>> provider: memory
# The memory provider needs no environment variables. It is used automatically when no database credentials are configured.
# <<< provider: memory
